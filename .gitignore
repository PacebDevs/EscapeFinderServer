# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

# Ignorar mapas generados
src/uploads/maps/

# Datos locales de preproducción (se recrean fuera de Git)
runtime/pre/

# Herramientas y documentación locales de cambio de entorno
scripts/use-dev.ps1
scripts/use-pre.ps1
GUIA_CAMBIO_ENTORNOS.md

# Configuración local y secretos
.env
.env.*
!.env.example
