FROM node:24-bookworm-slim

ENV NODE_ENV=production
WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --chown=node:node src ./src
RUN mkdir -p /app/src/uploads/salas /app/src/uploads/maps \
    && chown -R node:node /app

USER node
EXPOSE 3000

CMD ["npm", "start"]
