# Aplicación
NODE_ENV=production
PORT=3000
APP_DOMAIN=escapefinder-api.duckdns.org
BASE_URL=https://escapefinder-api.duckdns.org
ALLOWED_ORIGINS=http://localhost,capacitor://localhost,ionic://localhost
REQUIRE_EMAIL_VERIFICATION=false
UPLOADS_PATH=../data/uploads

# Base de datos y caché
POSTGRES_DB=escapefinderdb
POSTGRES_USER=escapefinder
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://escapefinder:PASSWORD@db:5432/escapefinderdb
REDIS_URL=redis://cache:6379

# Autenticación
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_API_KEY=replace-with-google-api-key

# Correo
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=escapefinder@zohomail.eu
SMTP_PASSWORD=replace-with-an-app-specific-password
EMAIL_FROM=escapefinder@zohomail.eu
